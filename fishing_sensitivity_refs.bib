@article{link2011,
  title = {Ecosystem-based Fisheries Management in the {{Northwest Atlantic}}},
  author = {Link, Jason S and Bundy, Alida and Overholtz, William J and Shackell, Nancy and Manderson, John and Duplisea, Daniel and Hare, Jon and Koen-Alonso, Mariano and Friedland, Kevin D},
  year = 2011,
  month = jun,
  journal = {Fish and Fisheries},
  volume = {12},
  number = {2},
  pages = {152--170},
  issn = {1467-2960, 1467-2979},
  doi = {10.1111/j.1467-2979.2011.00411.x},
  urldate = {2026-02-18},
  abstract = {Abstract             The northwest Atlantic has had a notable history of living marine resource (LMR) exploitation. There have been calls for evaluating and improving approaches to manage those resources as stocks have undergone sequential depletion, with some dramatic instances of stock declines. The need for more holistic ecosystem-based approaches to manage LMRs has been increasingly recognized as part of these calls, along with the recognition that there are broader issues to consider when managing a fishery. We discuss some of the major efforts to this end which are extant among our institutions. We emphasize current initiatives to implement ecosystem-based fisheries management in the northwest Atlantic, with a focus on how advice based on the natural sciences supports an ecosystem-based approach. We present this information as a case study within a rich historical context of fisheries science and management.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english}
}

