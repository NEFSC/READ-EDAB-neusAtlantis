#!/bin/bash
#SBATCH --job-name=atlantis_rerun_bundle
#SBATCH --partition=computelow
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --array=0

# This script was auto-generated by find_failed_runs.R

case $SLURM_ARRAY_TASK_ID in
   0) sim_ids="551";;
#  0) sim_ids="6 7 8 9 56 57 58 59 60 61 62 63 64 65 66 67 68 69 70 71 72 73 74 75 76 77 78 79 80 81 82 83 84 85 86 87";;
#  1) sim_ids="88 89 90 91 92 93 94 95 96 97 98 99 552 553 554 555 556 557 558 559 560 561 562 563 564 565 566 567 568 569 570 571 572 573 574 575";;
#  2) sim_ids="576 577 578 579 580 581 582 583 584 585 586 587 588 589 590 591 592 593 594 595 596 597 598 599 600 601 602 603 604 605 606 607 608 609 610 611";;
#  3) sim_ids="612 613 614 615 616 617 618 619 620 621 622 623 624 625 626 627 628 629 630 631 632 633 634 635 636 637 638 639 640 641 642 643 644 645 646 647";;
#  4) sim_ids="648 649 650 651 652 653 654 655 656 657 658 659 660";;
esac


echo "This is array job ${SLURM_ARRAY_TASK_ID}, rerunning simulations: ${sim_ids}"

for sim_id in ${sim_ids}; do
    # Use "&" to launch each singularity container in the background
    (
        echo "Starting simulation ${sim_id} on node $(hostname)"
        output_dir="/atlantisdisk2/eof_targeting_4/eof_targeting_4_${sim_id}"
        mkdir -p "${output_dir}"
        run_script="/app/model/runAtlantis_${sim_id}.sh"
        singularity exec \
            --bind /model/Joseph.Caracappa/READ-EDAB-neusAtlantis/currentVersion:/app/model,${output_dir}:/app/model/output \
            /model/atlantisCode/atlantis6681.sif \
            ${run_script} &> "${output_dir}/sim_${sim_id}_rerun.log"
        echo "Finished simulation ${sim_id}"
    ) &
done

# Wait for all background jobs launched in this script to finish
wait
echo "All simulations for array job ${SLURM_ARRAY_TASK_ID} are complete."
